# Normalise line endings: everything that runs inside Linux containers must be LF.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.lua     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Dockerfile text eol=lf

# Windows-only helper scripts keep CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
