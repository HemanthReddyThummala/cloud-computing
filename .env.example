# =====================================================================
# Distributed Multimodal Video Note-Taking Agent — environment template
# Copy to .env and fill in. NEVER commit .env. Values marked [SECRET]
# must only ever be typed into your local .env file.
# =====================================================================

# ---------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=notes-agent

# ---------------------------------------------------------------------
# PostgreSQL (job state store) — runs in Docker Compose
# ---------------------------------------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me                     # [SECRET] random, generated locally
POSTGRES_DB=notes
DATABASE_URL=postgresql://notes:change-me@postgres:5432/notes

# ---------------------------------------------------------------------
# RabbitMQ (durable broker) — runs in Docker Compose
# ---------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=notes
RABBITMQ_DEFAULT_PASS=change-me                 # [SECRET] random, generated locally
RABBITMQ_URL=amqp://notes:change-me@rabbitmq:5672/

# ---------------------------------------------------------------------
# Redis (global rate limits + shared cooldowns; no job data, no tokens)
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------
GATEWAY_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_EXTENSION_ORIGIN=chrome-extension://<EXTENSION_ID>
# Constraint A (ADR-14): the worker's TRANSCRIBING stage rejects longer videos (FAILED, VIDEO_TOO_LONG)
# before fetching the transcript. Exactly this many seconds is accepted.
MAX_VIDEO_DURATION_SEC=1200
# Preferred transcript languages, highest priority first (manual before auto-generated); otherwise the
# first available transcript is used. No YouTube API key is needed.
TRANSCRIPT_LANGUAGES=en
IDEMPOTENCY_KEY_TTL_HOURS=24

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Fernet key (urlsafe base64, 32 bytes) used to encrypt the Notion token
# inside the per-job RabbitMQ credential mailbox. Gateway + workers only.
JOB_PAYLOAD_ENCRYPTION_KEY=                     # [SECRET] generated locally
# Lifetime of the per-job credential mailbox: message TTL from submission (absolute) and
# queue x-expires (idle time).
CREDENTIAL_TTL_HOURS=24
# Max seconds a worker waits for a mailbox message still held by a crashed worker
# (must exceed RabbitMQ's dead-connection detection, ~60 s heartbeat).
CREDENTIAL_READ_WAIT_SEC=90

# ---------------------------------------------------------------------
# Google Gemini API — FREE TIER ONLY (no billing account on the project)
# ---------------------------------------------------------------------
GEMINI_API_KEY=                                 # [SECRET] from Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Shared rate limiter (ADR-13), enforced across ALL workers through Redis. These values are used
# AS GIVEN: enter your project's free-tier limits for GEMINI_MODEL from
# https://aistudio.google.com/rate-limit already multiplied by your safety margin (defaults below =
# AI Studio limits x 0.8). Limits are per Google project. RPD resets at midnight Pacific time.
GEMINI_RPM_LIMIT=4                              # requests per minute
GEMINI_TPM_LIMIT=200000                         # input tokens per minute
GEMINI_RPD_LIMIT=16                             # requests per day
# A worker waits in-process up to this long for the limiter; longer waits re-queue the job.
RATE_LIMIT_MAX_WAIT_SEC=60
# Shared cooldown after a provider 429 without a Retry-After header (Retry-After wins when present).
RATE_LIMIT_DEFAULT_COOLDOWN_SEC=10
# SUMMARIZING (ADR-15): estimated transcript tokens per Gemini request; longer transcripts are split
# into ordered chunks (+1 merge request). A ~20-minute talk normally fits in one request.
TRANSCRIPT_CHUNK_TOKENS=12000
# Maximum number of important timestamps (later: frames) per video.
MAX_FRAMES=8
# EXTRACTING_FRAMES (ADR-16): a video-only stream up to this height is downloaded once per job;
# frames are stored as JPEG at most this wide (never upscaled; each ≤ 5 MiB for Notion).
FRAME_SOURCE_MAX_HEIGHT=720
FRAME_MAX_WIDTH=1280

# ---------------------------------------------------------------------
# Notion (public integration / OAuth) — configured in Phase 5
# The client secret is used ONLY by the gateway, never by the extension.
# ---------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=                           # [SECRET]
NOTION_REDIRECT_URI=                            # set only after redirect-URI verification
# PUBLISHING (ADR-17): pages are created under the job's notion_parent_id or, if none was given, under
# this page (32 hex characters from the page URL, dashes optional; it must be shared with the
# integration during authorization). Without either, the job ends FAILED with NOTION_PARENT_MISSING.
NOTION_DEFAULT_PARENT_ID=                       # page ID of your "Video Notes" page
NOTION_VERSION=2026-03-11
NOTION_RPS_LIMIT=2.5                            # requests/second per connection (Notion documents avg 3/s)

# ---------------------------------------------------------------------
# Retries, backoff and dead-lettering
# ---------------------------------------------------------------------
MAX_ATTEMPTS=5            # total executions incl. the first (5 => at most 4 retries)
# Retries when our shared rate limiter (Redis) is unavailable — separate budget, provider not called.
INFRA_MAX_ATTEMPTS=20
# Backoff steps in seconds; the last step repeats (5 attempts => delays 10, 30, 90, 90).
# Demo profile for grading: BACKOFF_SCHEDULE_SEC=2,4,8 and MAX_ATTEMPTS=3.
# A delay queue jobs.retry.<N>s is declared for every value listed here.
BACKOFF_SCHEDULE_SEC=10,30,90
LOCK_RETRY_DELAY_SEC=5
INFRA_RETRY_DELAY_SEC=30
# RabbitMQ management API (used by scripts/migrate_work_queue.py; credentials come from RABBITMQ_URL)
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
QUEUE_DELIVERY_LIMIT=10
# The delivery limit of jobs.dlq.audit (ADR-12) is derived: QUEUE_DELIVERY_LIMIT + 11 (it must exceed
# QUEUE_DELIVERY_LIMIT + 1 because RabbitMQ carries the delivery count over when it dead-letters).
# Settings field AUDIT_QUEUE_DELIVERY_LIMIT can override it; docker-compose.yml does not pass it.
OUTBOX_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------
# Resource limits (sized for a 16 GB laptop; Docker VM has ~7.6 GiB)
# ---------------------------------------------------------------------
POSTGRES_MEM_LIMIT=512m
RABBITMQ_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=96mb
GATEWAY_MEM_LIMIT=256m
OUTBOX_MEM_LIMIT=192m
WORKER_MEM_LIMIT=768m
WORKER_REPLICAS=2

# ---------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Fault injection for live failure demos. Must stay false in normal use.
CHAOS_ENABLED=false
