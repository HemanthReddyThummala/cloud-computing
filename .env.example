# =====================================================================
# Distributed Multimodal Video Note-Taking Agent — environment template
# Copy to .env and fill in. NEVER commit .env. Values marked [SECRET]
# must only ever be typed into your local .env file.
# =====================================================================

# ---------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=notes-agent

# ---------------------------------------------------------------------
# PostgreSQL (job state store) — runs in Docker Compose
# ---------------------------------------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me                     # [SECRET] random, generated locally
POSTGRES_DB=notes
DATABASE_URL=postgresql://notes:change-me@postgres:5432/notes

# ---------------------------------------------------------------------
# RabbitMQ (durable broker) — runs in Docker Compose
# ---------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=notes
RABBITMQ_DEFAULT_PASS=change-me                 # [SECRET] random, generated locally
RABBITMQ_URL=amqp://notes:change-me@rabbitmq:5672/

# ---------------------------------------------------------------------
# Redis (global rate limits + shared cooldowns; no job data, no tokens)
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------
GATEWAY_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_EXTENSION_ORIGIN=chrome-extension://<EXTENSION_ID>
MAX_VIDEO_DURATION_SEC=1200
IDEMPOTENCY_KEY_TTL_HOURS=24

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Fernet key (urlsafe base64, 32 bytes) used to encrypt the Notion token
# inside the per-job RabbitMQ credential mailbox. Gateway + workers only.
JOB_PAYLOAD_ENCRYPTION_KEY=                     # [SECRET] generated locally
# Lifetime of the per-job credential mailbox queue (x-expires).
CREDENTIAL_TTL_HOURS=24

# ---------------------------------------------------------------------
# Google Gemini API — FREE TIER ONLY (no billing account on the project)
# ---------------------------------------------------------------------
GEMINI_API_KEY=                                 # [SECRET] from Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Copy your project's free-tier limits for GEMINI_MODEL from
# https://aistudio.google.com/rate-limit (limits are per project).
GEMINI_RPM_LIMIT=
GEMINI_TPM_LIMIT=
GEMINI_RPD_LIMIT=
GEMINI_LIMIT_SAFETY_FACTOR=0.8
LLM_MAX_WAIT_SEC=60
TRANSCRIPT_CHUNK_TOKENS=12000
MAX_FRAMES=8

# ---------------------------------------------------------------------
# Notion (public integration / OAuth) — configured in Phase 5
# The client secret is used ONLY by the gateway, never by the extension.
# ---------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=                           # [SECRET]
NOTION_REDIRECT_URI=                            # set only after redirect-URI verification
NOTION_DEFAULT_PARENT_ID=                       # page ID of your "Video Notes" page
NOTION_VERSION=2026-03-11
NOTION_RPS_LIMIT=2.5

# ---------------------------------------------------------------------
# Retries, backoff and dead-lettering
# ---------------------------------------------------------------------
MAX_ATTEMPTS=5
BACKOFF_SCHEDULE_SEC=10,30,90
BACKOFF_JITTER=0.2
QUEUE_DELIVERY_LIMIT=10
OUTBOX_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------
# Resource limits (sized for a 16 GB laptop; Docker VM has ~7.6 GiB)
# ---------------------------------------------------------------------
POSTGRES_MEM_LIMIT=512m
RABBITMQ_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=96mb
GATEWAY_MEM_LIMIT=256m
OUTBOX_MEM_LIMIT=192m
WORKER_MEM_LIMIT=768m
WORKER_REPLICAS=2

# ---------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Fault injection for live failure demos. Must stay false in normal use.
CHAOS_ENABLED=false
