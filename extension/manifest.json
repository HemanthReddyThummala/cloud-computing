{
  "manifest_version": 3,
  "name": "Video Notes Agent",
  "version": "0.1.0",
  "description": "Turn YouTube videos into structured study notes with real frames, published to Notion.",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Video Notes Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
